---
import BaseLayout from "../layouts/BaseLayout.astro";
import site from "../data/site.json";
import HeroLanding from "../components/HeroLanding.astro";
import SectionHeader from "../components/SectionHeader.astro";
import SectionImage from "../components/SectionImage.astro";
import WhitepaperContent from "../components/WhitepaperContent.astro";
---
<BaseLayout title={`${site.siteName} — ${site.tagline}`} description={site.description}>
  <HeroLanding site={site} />

  <section id="food" class="section">
    <div class="container">
      <SectionHeader eyebrow="Food" title="食 — Mother Vegetable の食領域" sub="栄養・機能・持続性に優れた価値提供" />
      <div class="panel reveal" style="margin-top:8px">
        <p class="muted">ホワイトペーパーの「食」セクションをベースに、栄養価の高い食品原料、バイオアクティブ成分、応用可能性（食品・サプリメント・機能性素材など）を要約して掲載します。</p>
      </div>
      <div style="margin-top:16px">
        <SectionImage src="/images/generated/apps.png" alt="食領域のイメージ" fallback="https://source.unsplash.com/1200x700/?superfood,algae,healthy" />
      </div>
    </div>
  </section>

  <section id="sixg" class="section">
    <div class="container">
      <SectionHeader eyebrow="6G" title="6G — 次世代通信 × 地球再生" sub="データ連携・透明性・分散化が支える循環設計" />
      <div class="panel reveal">
        <p class="muted">ホワイトペーパーの「6G」関連内容を要約し、分散ネットワーク、データ可視化、オンチェーン証跡の連携など、地球再生のための情報基盤としての位置づけを説明します。</p>
      </div>
    </div>
  </section>

  <section id="whitepaper" class="section">
    <div class="container">
      <SectionHeader eyebrow="Whitepaper" title="ホワイトペーパー（整形版）" sub="PDFの内容をWeb向けに再構成" />
      <WhitepaperContent />
    </div>
  </section>

  <section id="cta" class="section">
    <div class="container card" style="display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap: wrap;">
      <div>
        <h2 style="margin:0">{site.cta.primary}</h2>
        <div class="muted">最新情報は公式SNSでお知らせします。ホワイトペーパーも併せてご確認ください。</div>
      </div>
      <div style="display:flex; gap:12px; flex-wrap:wrap">
        <a class="btn primary" href="#top">ページ上部へ</a>
        <a class="btn ghost" href={site.links.whitepaper}>ホワイトペーパー</a>
      </div>
    </div>
    <div class="container" style="margin-top:14px;">
      <small class="muted">{site.legal.disclaimer}</small>
    </div>
  </section>

</BaseLayout>
